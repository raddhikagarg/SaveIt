# Database
DATABASE_URL=postgresql://user:password@localhost:5432/saveit

# LLM
ANTHROPIC_API_KEY=your_key_here

# Search fallback (Stage 3)
TAVILY_API_KEY=your_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_token_here

# Google Calendar
GOOGLE_CLIENT_ID=your_id_here
GOOGLE_CLIENT_SECRET=your_secret_here

# Auth
JWT_SECRET_KEY=change_this_to_a_random_string

# Google Calendar / Login redirect
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/callback

# Instagram webhook verification
INSTAGRAM_VERIFY_TOKEN=your_verify_token_here

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_WHATSAPP_NUMBER=your_whatsapp_number_here

# Whisper transcription
OPENAI_API_KEY=your_key_here
