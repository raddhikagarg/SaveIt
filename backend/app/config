"""
Central place to read all environment-based config.
Copy .env.example to .env and fill these in.
"""
import os
from dotenv import load_dotenv

load_dotenv()


class Settings:
    # Database
    DATABASE_URL: str = os.getenv("DATABASE_URL", "sqlite:///./deadlinedrop.db")

    # LLM extraction (Claude)
    ANTHROPIC_API_KEY: str = os.getenv("ANTHROPIC_API_KEY", "")
    LLM_MODEL: str = os.getenv("LLM_MODEL", "claude-sonnet-4-6")

    # Stage 3 live web search fallback
    TAVILY_API_KEY: str = os.getenv("TAVILY_API_KEY", "")

    # Telegram bot (primary demo intake channel)
    TELEGRAM_BOT_TOKEN: str = os.getenv("TELEGRAM_BOT_TOKEN", "")

    # Instagram Business Messaging API (secondary intake channel)
    INSTAGRAM_VERIFY_TOKEN: str = os.getenv("INSTAGRAM_VERIFY_TOKEN", "")
    INSTAGRAM_PAGE_ACCESS_TOKEN: str = os.getenv("INSTAGRAM_PAGE_ACCESS_TOKEN", "")

    # Google Calendar sync (calendar.events scope only)
    GOOGLE_CLIENT_ID: str = os.getenv("GOOGLE_CLIENT_ID", "")
    GOOGLE_CLIENT_SECRET: str = os.getenv("GOOGLE_CLIENT_SECRET", "")
    GOOGLE_REDIRECT_URI: str = os.getenv("GOOGLE_REDIRECT_URI", "http://localhost:8000/auth/google/callback")

    # Reminder tiers (days before deadline)
    REMINDER_DAYS_BEFORE = [3, 1]

    # Inactivity tiers (days since last open) for Govt Radar re-engagement nudges
    INACTIVITY_TIERS_DAYS = [3, 7, 14]


settings = Settings()
